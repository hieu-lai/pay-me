VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=


# Convex configuration, get this URL from your [Dashboard](dashboard.convex.dev)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
MONEY_REQUEST_INGRESS_ATTESTATION_SECRET=

# Convex server secrets for payment-destination encryption.
# Encryption keys are a JSON object of version names to base64-encoded 32-byte keys.
PAYMENT_DESTINATION_ENCRYPTION_KEYS={"v1":""}
PAYMENT_DESTINATION_CURRENT_ENCRYPTION_KEY_VERSION=v1
PAYMENT_DESTINATION_FINGERPRINT_KEY=

# Sandbox-only Zepto agreement creation. Production uses a separate credential
# path and cannot reuse this token slot.
ZEPTO_ENVIRONMENT=sandbox
ZEPTO_SANDBOX_PERSONAL_ACCESS_TOKEN=
